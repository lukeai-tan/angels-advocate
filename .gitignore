# --- OS cruft (you're crossing Windows <-> WSL, so ignore both) ---
.DS_Store
Thumbs.db
Desktop.ini
*~

# --- Editor / VS Code ---
.vscode/
*.code-workspace

# --- Angel's Advocate decision journal (private per-machine log) ---
.angel-advoc/

# --- Python bytecode (from sweep workflow / tooling runs) ---
__pycache__/
*.pyc

# --- Secrets / local overrides (nothing here today, but cheap insurance) ---
.env
.env.*
*.local

# --- Logs ---
*.log
